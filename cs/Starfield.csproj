<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseCnaCs Condition="'$(UseCnaCs)' == ''">false</UseCnaCs>
    <CnaCsRoot Condition="'$(CnaCsRoot)' == ''">$(MSBuildThisFileDirectory)..\..\cna-cs</CnaCsRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseCnaCs)' == 'true'">
    <ProjectReference Include="$(CnaCsRoot)\src\CNA.XnaCompat\CNA.XnaCompat.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseCnaCs)' != 'true'">
    <Compile Remove="CnaXnaBindingProbe.cs" />
  </ItemGroup>
</Project>